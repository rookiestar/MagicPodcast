{
  "name": "magicpodcast-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "build:skip-type": "NEXT_PRIVATE_SKIP_TYPE_CHECK=true next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "clean": "../scripts/clean-cache.sh --frontend",
    "clean:deep": "../scripts/clean-cache.sh --frontend --deep",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-virtual": "^3.13.18",
    "axios": "^1.18.1",
    "dompurify": "^3.4.12",
    "next": "^16.2.10",
    "pinyin-pro": "^3.28.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "happy-dom": "^20.4.0",
    "postcss": "^8.5.17",
    "tailwindcss": "^3.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "form-data": "4.0.6",
    "postcss": "$postcss"
  }
}
