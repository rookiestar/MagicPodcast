    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-virtual": "^3.13.18",
    "axios": "^1.18.1",
    "dompurify": "^3.4.13",
    "lxgw-wenkai-screen-webfont": "1.7.0",
    "next": "^16.3.0",
    "pinyin-pro": "^3.28.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
