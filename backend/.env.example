# MagicPodcast 环境变量配置示例
# 复制此文件为 .env 并填入实际值
#
# 使用方法：
# 1. cp .env.example .env
# 2. 编辑 .env 文件，填入实际的敏感信息
# 3. 确保 .env 已添加到 .gitignore（避免提交敏感信息）
# 4. 启动服务前执行: source .env 或 export $(cat .env | xargs)

# ============================================
# LLM 配置
# ============================================
# 智谱AI API Key（格式: id.secret）
MAGICPODCAST_LLM_API_KEY=your_zhipuai_api_key_here

# ============================================
# 邮件通知配置（SMTP）
# ============================================
# SMTP服务器地址
MAGICPODCAST_SMTP_HOST=smtp.gmail.com
# SMTP端口（465 for SSL, 587 for STARTTLS）
MAGICPODCAST_SMTP_PORT=587
# 发件邮箱账号
MAGICPODCAST_SMTP_USERNAME=your_email@gmail.com
# 邮箱授权码/密码（不是登录密码，是SMTP专用授权码）
MAGICPODCAST_SMTP_PASSWORD=your_smtp_app_password

# ============================================
# 小宇宙用户凭证（自动同步，通常不需要手动配置）
# ============================================
# 小宇宙手机号
MAGICPODCAST_USER_PHONE=13800138000
# 访问令牌
MAGICPODCAST_USER_ACCESS_TOKEN=your_access_token
# 刷新令牌
MAGICPODCAST_USER_REFRESH_TOKEN=your_refresh_token
